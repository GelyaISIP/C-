<Window x:Class="LogisticSystem.View.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem.View"
        mc:Ignorable="d"
        Title="OrderWindow" Height="450" Width="800" Background="#E6E6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Новый заказ" FontSize="20" FontWeight="Bold"/>
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Клиент:" FontSize="16"/>
                    <ComboBox x:Name="cbClients" Height="20" Background="White"/>
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Дата заказа:" FontSize="16"/>
                    <ComboBox x:Name="dpOrderDate" Height="20" Background="White"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
        <GroupBox Grid.Row="1" Header="Товары в заказе">
            <Grid>
                <DataGrid x:Name="dgOrderItems" AutoGenerateColumns="False" Margin="5" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Width="100"/>
                        <DataGridTextColumn Header="Склад" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnAddProduct" Background="#4B0082" Foreground="White" FontWeight="Bold" Content="Добавить товар" Width="130" Height="35" Margin="0,0,10,0"></Button>
            <Button x:Name="btnSaveOrder" Background="#4B0082" Foreground="White" FontWeight="Bold" Content="Оформить заказ" Width="130" Height="35" ></Button>
        </StackPanel>
    </Grid>

</Window>
