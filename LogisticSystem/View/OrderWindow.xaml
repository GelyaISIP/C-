<Window x:Class="LogisticSystem.View.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem.View"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:helper="clr-namespace:LogisticSystem.Helper"
        mc:Ignorable="d"
        Title="Личный кабинет клиента" Height="500" Width="800" Background="#E6E6FA">
    <Window.Resources>
        <helper:StatusConverter x:Key="StatusConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <TabControl>
            <!-- Вкладка "Новый заказ" -->
            <TabItem Header="Новый заказ" Background="#E6E6FA">
                <Grid Background="#E6E6FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Оформление заказа" FontSize="20" FontWeight="Bold"/>
                        <UniformGrid Columns="2" Width="300" HorizontalAlignment="Left">
                            <TextBlock Text="Дата заказа:" FontSize="16" Height="24"/>
                            <DatePicker x:Name="dpOrderDate" Height="26" SelectedDate="{x:Static sys:DateTime.Now}" Margin="10,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                    <GroupBox Grid.Row="1" Header="Товары в заказе">
                        <DataGrid x:Name="dgOrderItems" AutoGenerateColumns="False" Margin="5" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
                                <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnAddProduct" Background="#4B0082" Foreground="White" FontWeight="Bold" Content="Добавить товар" Width="130" Height="35" Margin="0,0,20,0" Click="btnAddProduct_Click"/>
                        <Button x:Name="btnSaveOrder" Background="#4B0082" Foreground="White" FontWeight="Bold" Content="Оформить заказ" Width="130" Height="35" Margin="0,0,15,0" Click="btnSaveOrder_Click"/>
                        <Button x:Name="btnAccount" Background="#4B0082" Foreground="White" FontWeight="Bold" Content="Личный кабинет" Width="130" Height="35" Margin="0,0,10,0" Click="btnAccount_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Вкладка "История заказов" -->
            <TabItem Header="История заказов" x:Name="tabHistory" GotFocus="TabHistory_GotFocus" Background="#E6E6FA">
                <Grid Background="#E6E6FA">
                    <DataGrid x:Name="dgOrderHistory" AutoGenerateColumns="False" IsReadOnly="True" Margin="5" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ заказа" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource StatusConverter}}" Width="120"/>
                            <DataGridTextColumn Header="Кол-во товаров" Binding="{Binding OrderProducts.Count}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>