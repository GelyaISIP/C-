<Window x:Class="LogisticSystem.View.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
        Title="Отчёты" Height="420" Width="650" Background="#E6E6FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: тип отчета + период + кнопка в одну строку -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Тип отчёта:" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <ComboBox x:Name="cbReportType" Width="120" Margin="0,0,15,0" SelectionChanged="CbReportType_SelectionChanged">
                <ComboBoxItem Content="Отгрузки" IsSelected="True"/>
                <ComboBoxItem Content="Заказы"/>
                <ComboBoxItem Content="Пользователи"/>
            </ComboBox>

            <TextBlock Text="с:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker x:Name="dpStart" Width="110" SelectedDate="{Binding StartDate, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <TextBlock Text="по:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker x:Name="dpEnd" Width="110"/>

            <Button Content="Сформировать" Width="100" Margin="20,0,0,0" Click="GenerateReport_Click" Background="#4B0082" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Таблица результатов -->
        <DataGrid x:Name="dgReport" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"/>
    </Grid>
</Window>