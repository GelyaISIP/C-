<Window x:Class="LogisticSystem.View.AddEditShipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
        Title="Отгрузка" Height="650" Width="700" Background="#E6E6FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор заказа -->
        <TextBlock Grid.Row="0" Text="Заказ:" Margin="5"/>
        <ComboBox x:Name="cbOrder" Grid.Row="0" Margin="174,0,0,26" HorizontalAlignment="Left" Width="200"
                  DisplayMemberPath="Info" SelectedValuePath="Id" SelectionChanged="CbOrder_SelectionChanged" Grid.RowSpan="2"/>

        <!-- Информация о клиенте -->
        <TextBlock Grid.Row="1" Text="Клиент:" Margin="5"/>
        <TextBlock x:Name="tbOrderInfo" Grid.Row="1" Margin="174,0,0,26" HorizontalAlignment="Left" Grid.RowSpan="2" Width="377"/>

        <!-- Выбор склада для отгрузки -->
        <TextBlock Grid.Row="2" Text="Склад отгрузки:" Margin="5"/>
        <ComboBox x:Name="cbWarehouse" Grid.Row="1" Margin="174,23,0,3" HorizontalAlignment="Left" Width="200"
                  DisplayMemberPath="Name" SelectedValuePath="Id" Grid.RowSpan="2"/>

        <!-- Плановая дата -->
        <TextBlock Grid.Row="3" Text="Плановая дата отгрузки:" Margin="5"/>
        <DatePicker x:Name="dpPlannedShipmentDate" Grid.Row="3" Margin="174,0,0,5" HorizontalAlignment="Left" Width="150"/>

        <!-- Вкладки с товарами и остатками -->
        <TabControl Grid.Row="4" Margin="0,10,0,10">
            <TabItem Header="Товары в заказе">
                <DataGrid x:Name="dgOrderProducts" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*"/>
                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Остатки на складах">
                <DataGrid x:Name="dgStocks" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="150"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Фактическая дата (только для редактирования) -->
        <TextBlock Grid.Row="5" Text="Фактическая дата отгрузки:" Margin="5"/>
        <DatePicker x:Name="dpActualShipmentDate" Grid.Row="5" Margin="174,3,0,10" HorizontalAlignment="Left" Width="150"
                    IsEnabled="{Binding IsEdit, RelativeSource={RelativeSource AncestorType=Window}}" RenderTransformOrigin="1.07,0.512"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Сохранить" Width="80" Margin="5" Click="Save_Click" Background="#4B0082" Foreground="White" IsDefault="True"/>
            <Button Content="Отмена" Width="80" Margin="5" IsCancel="True" Background="#4B0082" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
