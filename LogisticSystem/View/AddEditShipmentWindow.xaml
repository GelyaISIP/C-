<Window x:Class="LogisticSystem.View.AddEditShipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
        Title="Отгрузка" Height="180" Width="400" Background="#E6E6FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Заказ:" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbOrder" Grid.Row="0" Grid.Column="1" Margin="5" DisplayMemberPath="Id" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Склад:" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbWarehouse" Grid.Row="1" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата отгрузки:" Margin="5" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpShipmentDate" Grid.Row="2" Grid.Column="1" Margin="5" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button x:Name="btnSave" Content="Сохранить" Background="#4B0082" Foreground="White" Width="80" Margin="5" Click="Save_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Background="#4B0082" Foreground="White" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
