<Window x:Class="LogisticSystem.View.AuthorizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="400" Background="#E6E6FA">
    <StackPanel Margin="30">
        <TextBlock Text="Система логистики" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,10"/>
        
        <TextBlock Text="Логин" FontSize="16" Margin="0,10,0,5"/>
        <TextBox x:Name="txtLogin" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>

        <TextBlock Text="Пароль" FontSize="16"  Margin="0,20,0,5"/>
        <PasswordBox x:Name="txtPassword" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>

        <Button Content="Вход" Foreground="White" Height="40" Margin="0,40,0,10" FontSize="24" FontWeight="Bold" Background="#4B0082" Click="btnLogin_Click"></Button>
        <Button Content="Выход" Foreground="White" Height="40" FontSize="24" FontWeight="Bold" Background="#4B0082" Click="btnExit_Click"></Button>

    </StackPanel>
</Window>
