<Window x:Class="LogisticSystem.View.OrdersManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
         Title="Управление заказами" Height="500" Width="600" Background="#E6E6FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <!-- На подумать пока что -->
            <!-- <Button Content="Редактировать" Width="100" Margin="5" x:Name="btnEdit" IsEnabled="False" Click="EditOrder_Click" Background="#4B0082" Foreground="White"/> -->
            <Button Content="Удалить" Width="100" Margin="5" x:Name="btnDelete" IsEnabled="False" Click="DeleteOrder_Click" Background="#4B0082" Foreground="White"/>
            <Button Content="Обновить" Width="100" Margin="5" Click="Refresh_Click" Background="#4B0082" Foreground="White"/>
        </StackPanel>
        <DataGrid x:Name="dgOrders" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="dgOrders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.Name}" Width="150"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
