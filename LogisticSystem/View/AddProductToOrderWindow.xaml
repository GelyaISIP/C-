<Window x:Class="LogisticSystem.View.AddProductToOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem.View"
        mc:Ignorable="d"
        Title="Добавить товар" Height="300" Width="400" Background="#E6E6FA">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Товар:" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbProduct" Grid.Row="0" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Склад:" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cbWarehouse" Grid.Row="1" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Количество:" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="tbQuantity" Grid.Row="2" Grid.Column="1" Margin="5" Text="1"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" Background="#4B0082" Foreground="White" Width="80" Margin="5" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Отмена" Background="#4B0082" Foreground="White" Width="80" Margin="5" IsCancel="True"/>
        </StackPanel>
    </Grid>
    
</Window>
