<Window x:Class="LogisticSystem.View.ClientAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem.View"
        mc:Ignorable="d"
        Title="Личный кабинет" Height="480" Width="400" Background="#E6E6FA">
    <StackPanel Margin="20">
        <TextBlock Text="Личный кабинет" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,10"/>

        <TextBlock Text="Смена пароля" FontSize="20" Margin="0,10,0,5" HorizontalAlignment="Center"/>
        <TextBlock Text="Новый пароль" FontSize="18" Margin="0,10,0,5" HorizontalAlignment="Left"/>
        <PasswordBox x:Name="txtNewPassword" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>
        <TextBlock Text="Подтвердите пароль" FontSize="18" Margin="0,10,0,5" HorizontalAlignment="Left"/>
        <PasswordBox x:Name="txtApprovNewPass" Height="35" VerticalContentAlignment="Center" Padding="10,0"/>

        <Button Content="Сохранить"  Foreground="White" Height="40" Margin="0,30,0,10" FontSize="24" FontWeight="Bold" Background="#4B0082" Click="btnSavePass_Click"/>
        <Button Content="Отмена"  Foreground="White" Height="40" Margin="0,30,0,10" FontSize="24" FontWeight="Bold" Background="#4B0082" Click="btnCancel_Click"/>
    </StackPanel>
</Window>
