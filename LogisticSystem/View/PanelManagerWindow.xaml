<Window x:Class="LogisticSystem.View.PanelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
        Title="Система логистики" Height="700" Width="750" Background="#E6E6FA">
    <Grid Margin="30">
        <StackPanel>
            <TextBlock Text="Панель менеджера" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            <Button Content="Панель управления (товары/склады)" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="OpenAdminPanel_Click" Width="555"/>
            <Button Content="Управление заказами" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="OpenOrdersManagement_Click" Width="555"/>
            <Button Content="Оформить заказ" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="OpenOrderWindow_Click" Width="555"/>
            <Button Content="Управление отгрузками" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="OpenShipments_Click" Width="555"/>
            <Button Content="Управление пользователями" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="OpenUserManagement_Click" Width="555"/>
            <Button Content="Отчёты" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="OpenReports_Click" Width="555"/>
			<Button Content="Личный кабинет" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,10" Click="btnAccount_CLick" Width="555"/>
            <Button Content="Выход" Height="40" FontSize="18" Background="#4B0082" Foreground="White" Margin="0,50,0,0" Click="Exit_Click" Width="555"/>
        </StackPanel>
    </Grid>
</Window>