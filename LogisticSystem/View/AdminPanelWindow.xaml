<Window x:Class="LogisticSystem.View.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogisticSystem"
        mc:Ignorable="d"
        Title="AdminPanelWindow" Height="420" Width="600" Background="#E6E6FA">
    <Grid Margin="10">
        <TabControl Background="#E6E6FA">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#E6E6FA"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#9D81BA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Товары">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Добавить товар" Width="120" Margin="5" Click="AddProduct_Click" Background="#4B0082" Foreground="White"/>
                        <Button x:Name="btnEditProduct" Content="Редактировать" Width="100" Margin="5" IsEnabled="False" Click="EditProduct_Click" Background="#4B0082" Foreground="White"/>
                        <Button x:Name="btnDeleteProduct" Content="Удалить" Width="100" Margin="5" IsEnabled="False" Click="DeleteProduct_Click" Background="#4B0082" Foreground="White"/>
                    </StackPanel>
                    <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgProducts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding SKU}" Width="*"/>
                            <DataGridTextColumn Header="Остаток по складам" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Склады">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Добавить склад" Width="120" Margin="5" Click="AddWarehouse_Click" Background="#4B0082" Foreground="White"/>
                        <Button x:Name="btnEditWarehouse" Content="Редактировать" Width="100" Margin="5" IsEnabled="False" Click="EditWarehouse_Click" Background="#4B0082" Foreground="White"/>
                        <Button x:Name="btnDeleteWarehouse" Content="Удалить" Width="100" Margin="5" IsEnabled="False" Click="DeleteWarehouse_Click" Background="#4B0082" Foreground="White"/>
                    </StackPanel>
                    <DataGrid x:Name="dgWarehouses" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgWarehouses_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Location}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
